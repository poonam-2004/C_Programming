#include<stdio.h>

///////////////////////////////////////////////////////////
// Function Name : Max
// Description   : Finds maximum element from array
// Input         : Generic array, Size, Data type
// Author        : Poonam Narayan Palkar
// Date          : 06/01/2026
///////////////////////////////////////////////////////////
void Max(void *arr, int size, void *ans, char type)
{
    int i;
    if(type == 'i')
    {
        int max = *((int*)arr);
        for(i = 1; i < size; i++)
            if(*((int*)arr + i) > max)
                max = *((int*)arr + i);
        *(int*)ans = max;
    }
    else if(type == 'f')
    {
        float max = *((float*)arr);
        for(i = 1; i < size; i++)
            if(*((float*)arr + i) > max)
                max = *((float*)arr + i);
        *(float*)ans = max;
    }
}

///////////////////////////////////////////////////////////
// Entry Point Function
///////////////////////////////////////////////////////////
int main()
{
    int arr[] = {10,20,30,40,50};
    float brr[] = {10.0,3.7,9.8,8.7};
    int iRet;
    float fRet;

    Max(arr, 5, &iRet, 'i');
    printf("%d\n", iRet);

    Max(brr, 4, &fRet, 'f');
    printf("%f\n", fRet);

    return 0;
}